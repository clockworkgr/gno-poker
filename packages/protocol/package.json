{
  "name": "@gno-poker/protocol",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./gno": {
      "types": "./dist/gno.d.ts",
      "default": "./dist/gno.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "bench": "node scripts/bench.ts",
    "vectors": "node scripts/vectors.ts",
    "prepare": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@gnolang/gno-js-client": "^3.1.0",
    "@gnolang/tm2-js-client": "^3.3.0",
    "@noble/hashes": "^2.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
