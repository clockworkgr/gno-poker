// D[i] = canonical[perm(seedA)[i]] ^ shuffleKey(seedA) mod P (protocol section 4.1).
func TestGeneratedVectorsShufflePassA(t *testing.T) {
	seed := genSeed(t, "0101010101010101010101010101010101010101010101010101010101010101")
	canon := canonicalDeck()
	perm := Permutation(seed)
	e := ShuffleKey(seed)
	p := P()
	deck := make([]byte, 0, DeckLen)
	for i := 0; i < DeckSize; i++ {
		src := canon[perm[i]*CardLen : (perm[i]+1)*CardLen]
		deck = append(deck, modexp.ModExp(src, e, p)...)
	}
	genExpectHex(t, "shufflePassCanonicalA.root", MerkleRoot(deck), "ed65880b2f2ff3752acd81d271bdae858299ee8b5dbf4ab78bab7924b4244fe7")
	genExpectHex(t, "shufflePassCanonicalA.first", deck[:CardLen], "")
	genExpectHex(t, "shufflePassCanonicalA.last", deck[51*CardLen:], "")
	genExpectHex(t, "shufflePassCanonicalA.element7", deck[7*CardLen:8*CardLen], "")
	genExpectHex(t, "shufflePassCanonicalA.proofIndex7", MerkleProof(deck, 7), "")
	if !VerifyProof(MerkleRoot(deck), deck[7*CardLen:8*CardLen], 7, MerkleProof(deck, 7)) {
		t.Fatal("proof for index 7 does not verify")
	}
	if _, root, err := ParseDeck(EncodeDeck(deck)); err != nil || EncodeHex(root) != "ed65880b2f2ff3752acd81d271bdae858299ee8b5dbf4ab78bab7924b4244fe7" {
		t.Fatalf("ParseDeck: %v", err)
	}
}
