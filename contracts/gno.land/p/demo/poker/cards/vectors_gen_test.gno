	genExpectHex(t, "seedA.cardKey51", CardKey(seed, 51), "ae6998bfb1aa55efdb77c5c884b1da0bc686e130a209c1e554ec2af13784c6a3")
	want := []int{0, 31, 13, 36, 24, 2, 4, 21, 14, 29, 51, 35, 28, 19, 20, 46, 26, 9, 23, 25, 34, 47, 37, 15, 44, 17, 10, 30, 38, 6, 42, 39, 49, 50, 12, 22, 7, 43, 5, 18, 8, 48, 45, 40, 32, 1, 11, 3, 33, 41, 27, 16}
	got := Permutation(seed)
