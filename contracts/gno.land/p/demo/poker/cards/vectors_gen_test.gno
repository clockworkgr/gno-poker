func genExpectHex(t *testing.T, what string, got []byte, want string) {
	t.Helper()
	if EncodeHex(got) != want {
		t.Errorf("%s: got %s, want %s", what, EncodeHex(got), want)
	}
}

func genSeed(t *testing.T, h string) []byte {
	b, err := DecodeHex(h, 32)
	if err != nil {
		t.Fatal(err)
	}
	return b
}

func TestGeneratedVectorsGroup(t *testing.T) {
	genExpectHex(t, "P", P(), "")
	genExpectHex(t, "CanonRoot()", CanonRoot(), "cbbd0f99d1b6d995ea84edbcf80a62c245ea59240ccee3fde85b87bd35077030")
	deck := canonicalDeck()
	genExpectHex(t, "MerkleRoot(canonical deck)", MerkleRoot(deck), "cbbd0f99d1b6d995ea84edbcf80a62c245ea59240ccee3fde85b87bd35077030")
	genExpectHex(t, "m0", deck[:CardLen], "")
	genExpectHex(t, "m51", deck[51*CardLen:], "")
}

